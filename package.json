{
  "name": "keypress-theme",
  "version": "1.1.0",
  "type": "module",
  "description": "A modern, fully functional web publishing platform built with Astro and Cloudflare Pages, designed for fast, scalable, and customizable websites.",
  "author": {
    "name": "Sandhata Prajapati"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "astro dev",
