    "@astrojs/sitemap": "^3.7.3",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.2.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "pagefind": "^1.3.0"
  },
