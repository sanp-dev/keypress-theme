                  <span class="text-[14px] text-[#3c4043] font-['Google_Sans',Arial,sans-serif]">x.com</span>
                </a>
              </li>
              <li>
                <a href="#" class="article-share__link-text share-action" data-platform="facebook">
                  <svg class="w-[18px] h-[18px] mr-4 fill-[#3c4043]"><use href="#social-facebook"></use></svg>
                  <span class="text-[14px] text-[#3c4043] font-['Google_Sans',Arial,sans-serif]">Facebook</span>
                </a>
              </li>
              <li>
                <a href="#" class="article-share__link-text share-action" data-platform="linkedin">
                  <svg class="w-[18px] h-[18px] mr-4 fill-[#3c4043]"><use href="#social-linkedin"></use></svg>
