---
// src/pages/post/[id].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import ListenArticle from '../../components/ListenArticle.astro';
import AISummaryModal from '../../components/AISummaryModal.astro';
import Newsletter from '../../components/Newsletter.astro';
import AdSense from '../../components/AdSense.astro';
import McqStyles from '../../components/McqStyles.astro';
import PopularPosts from '../../components/PopularPosts.astro';
import FlashcardStyles from '../../components/FlashcardStyles.astro';
import { AUTHOR_REGISTRY } from '../../config/authors';
import { SITE_CONFIG } from '../../config/site';
import { Image } from 'astro:assets';
import { cleanImageUrl } from '../../utils/image';

const profilesBySlug = Object.fromEntries(
  Object.values(AUTHOR_REGISTRY).map((p) => [p.slug, p])
);

function capitalize(str: string) {
  return str
    .split(' ')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Dynamically calculate reading time (average 200 words per minute)
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', { 
  year: 'numeric',
  month: 'short', 
  day: '2-digit' 
});

const allPosts = await getCollection('blog');
let relatedPosts = allPosts.filter(p => p.data.category === post.data.category && p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

if (relatedPosts.length < 4) {
  const otherPosts = allPosts.filter(p => p.id !== post.id && !relatedPosts.some(rp => rp.id === p.id))
    .sort(() => 0.5 - Math.random());
  relatedPosts = [...relatedPosts, ...otherPosts];
}

relatedPosts = relatedPosts.slice(0, 4);

const categorySlug = post.data.category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');

const authorSlugResolved =
  post.data.authorSlug ||
  post.data.author.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
const authorAvatarUrl = profilesBySlug[authorSlugResolved]?.avatarUrl ?? null;
const authorRole = profilesBySlug[authorSlugResolved]?.role ?? 'Author';
const cleanedHeroImage = cleanImageUrl(post.data.image);

// ═══════════════════════════════════════════════════════
// Build-time Content Detection for Conditional Injection
// Scans raw markdown body for component markers.
// CSS/JS/Schema injected ONLY when components are present.
// ═══════════════════════════════════════════════════════
const postBody = post.body || '';
const hasMcqs = postBody.includes('qd-quiz-wrap');
const hasFlashcards = postBody.includes('qd-flashcard-deck');
const hasFaqs = /\<details[\s>]/.test(postBody) && postBody.includes('<summary');

// Auto-generate Flashcard Education Q&A Schema (Google ACTIVE feature)
let flashcardSchema: Record<string, any> | null = null;
if (hasFlashcards) {
  const cardMatches = [...postBody.matchAll(/data-front="([^"]*)"[\s\S]*?data-back="([^"]*)"/g)];
  if (cardMatches.length > 0) {
    flashcardSchema = {
      "@context": "https://schema.org/",
      "@type": "Quiz",
      "about": { "@type": "Thing", "name": post.data.title },
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "alignmentType": "educationalSubject",
          "targetName": post.data.category || "Education"
        }
      ],
      "hasPart": cardMatches.map(m => ({
        "@type": "Question",
        "eduQuestionType": "Flashcard",
        "text": m[1],
        "acceptedAnswer": { "@type": "Answer", "text": m[2] }
      }))
    };
  }
}

// Auto-generate FAQ Schema (deprecated rich result but helpful for AI understanding)
let faqSchema: Record<string, any> | null = null;
if (hasFaqs) {
  const faqMatches = [...postBody.matchAll(/<summary>([\s\S]*?)<\/summary>[\s\S]*?<p>([\s\S]*?)<\/p>/g)];
  if (faqMatches.length > 0) {
    faqSchema = {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqMatches.map(m => ({
        "@type": "Question",
        "name": m[1].replace(/<[^>]*>/g, '').trim(),
        "acceptedAnswer": {
          "@type": "Answer",
          "text": m[2].replace(/<[^>]*>/g, '').trim()
        }
      }))
    };
  }
}
---

