  <main class="max-w-[1000px] xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16">
    <div class="max-w-[1000px] mx-auto">
    
    <nav aria-label="Breadcrumb" class="flex items-center text-[12px] font-medium tracking-[0.5px] text-[#1a73e8] uppercase mb-8 font-['Google_Sans',Arial,sans-serif]">
