  description={post.data.description}
  image={post.data.image}
  url={Astro.url.href}
  type="article"
  author={post.data.author}
  publishedTime={post.data.pubDate}
  category={post.data.category}
  tags={post.data.tags}
  breadcrumbs={[
    { name: "Home", url: Astro.url.origin + "/" },
    { name: post.data.category, url: `${Astro.url.origin}/category/${categorySlug}/` },
    { name: post.data.title, url: Astro.url.href }
  ]}
