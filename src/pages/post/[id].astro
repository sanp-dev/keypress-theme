                  <svg class="w-[18px] h-[18px] mr-4 fill-[#3c4043]"><use href="#social-x"></use></svg>
                  <span class="text-[14px] text-[#3c4043] font-['Google_Sans',Arial,sans-serif]">x.com</span>
                </a>
              </li>
              <li>
                <a href="#" class="article-share__link-text share-action" data-platform="facebook">
                  <svg class="w-[18px] h-[18px] mr-4 fill-[#3c4043]"><use href="#social-facebook"></use></svg>
                  <span class="text-[14px] text-[#3c4043] font-['Google_Sans',Arial,sans-serif]">Facebook</span>
                </a>
              </li>
              <li>
                <a href="#" class="article-share__link-text share-action" data-platform="linkedin">
                  <svg class="w-[18px] h-[18px] mr-4 fill-[#3c4043]"><use href="#social-linkedin"></use></svg>
                  <span class="text-[14px] text-[#3c4043] font-['Google_Sans',Arial,sans-serif]">LinkedIn</span>
                </a>
              </li>
              <li>
                <a href="#" class="article-share__link-text share-action" data-platform="whatsapp">
                  <svg class="w-[18px] h-[18px] mr-4 fill-[#3c4043]"><use href="#social-whatsapp"></use></svg>
                  <span class="text-[14px] text-[#3c4043] font-['Google_Sans',Arial,sans-serif]">WhatsApp</span>
                </a>
              </li>
              <li>
                <a href="#" class="article-share__link-text share-action" data-platform="email">
                  <svg class="w-[18px] h-[18px] mr-4 fill-[#3c4043]"><use href="#social-mail"></use></svg>
                  <span class="text-[14px] text-[#3c4043] font-['Google_Sans',Arial,sans-serif]">Mail</span>
                </a>
              </li>
              <li>
                <a href="#" class="article-share__link-text share-action" data-platform="copy">
                  <svg class="w-[18px] h-[18px] mr-4 fill-[#3c4043]"><use href="#social-link"></use></svg>
                  <span class="text-[14px] text-[#3c4043] font-['Google_Sans',Arial,sans-serif]">Copy link</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Rest of the Article -->
    <figure class="w-full mb-12">
      {cleanedHeroImage && (
        <Image 
          src={cleanedHeroImage} 
          alt={post.data.title} 
          width={1000}
          height={563}
          widths={[480, 768, 1000, 1200, 1600]}
          sizes="(max-width: 1024px) 100vw, 1000px"
          class="w-full h-auto aspect-[16/9] object-cover rounded-[4px]"
          loading="eager"
          fetchpriority="high"
          quality={75}
        />
      )}
      {post.data.image_caption && (
        <figcaption class="text-center text-[14px] text-[#5f6368] italic mt-3">
          {post.data.image_caption}
        </figcaption>
      )}
    </figure>

