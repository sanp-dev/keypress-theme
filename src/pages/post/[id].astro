  <script is:inline define:vars={{ adsenseId: SITE_CONFIG.googleAdsenseId }}>
    // Robust copy-to-clipboard utility
    function copyTextToClipboard(text, callback) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(callback).catch(() => {
          fallbackCopy(text, callback);
        });
      } else {
        fallbackCopy(text, callback);
      }
    }

    function fallbackCopy(text, callback) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.position = "fixed"; // avoid scrolling to bottom
      textArea.style.opacity = "0";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand('copy');
        callback();
      } catch (err) {
        console.error('Fallback copy failed', err);
      }
      document.body.removeChild(textArea);
    }

    document.addEventListener("DOMContentLoaded", () => {
      // Wrap all markdown tables inside articleContent to make them responsive and scrollable
      const tables = document.querySelectorAll('#articleContent table');
      tables.forEach(table => {
        if (!table.closest('.qd-table-wrap')) {
          const wrapper = document.createElement('div');
          wrapper.className = 'qd-table-wrap';
          table.parentNode.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        }
      });

      const shareContainers = document.querySelectorAll('.share-menu-container');
      
      shareContainers.forEach(container => {
        const shareBtn = container.querySelector('.share-trigger-btn');
        const shareDropdown = container.querySelector('.share-dropdown');
        
        shareBtn.addEventListener('click', (e) => {
          e.stopPropagation(); 
          
          // Close other open share dropdowns first
          shareContainers.forEach(otherContainer => {
            if (otherContainer !== container) {
              otherContainer.querySelector('.share-dropdown').classList.remove('uni-social-share__show-dialog');
              otherContainer.querySelector('.share-trigger-btn').classList.remove('active');
            }
          });

          shareDropdown.classList.toggle('uni-social-share__show-dialog');
          shareBtn.classList.toggle('active');
        });
      });

      document.addEventListener('click', (e) => {
        shareContainers.forEach(container => {
          const shareBtn = container.querySelector('.share-trigger-btn');
          const shareDropdown = container.querySelector('.share-dropdown');
          if (!container.contains(e.target)) {
            shareDropdown.classList.remove('uni-social-share__show-dialog');
            shareBtn.classList.remove('active');
          }
        });
      });

      const shareActions = document.querySelectorAll('.share-action');
      const currentUrl = encodeURIComponent(window.location.href);
      const titleElement = document.getElementById('articleTitle');
      const currentTitle = encodeURIComponent(titleElement ? titleElement.textContent : document.title);

      shareActions.forEach(action => {
        action.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const platform = action.getAttribute('data-platform');
          let shareUrl = '';

          switch (platform) {
            case 'x':
              shareUrl = `https://twitter.com/intent/tweet?url=${currentUrl}&text=${currentTitle}`;
              window.open(shareUrl, '_blank', 'width=600,height=400');
              break;
            case 'facebook':
              shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`;
              window.open(shareUrl, '_blank', 'width=600,height=400');
              break;
            case 'linkedin':
              shareUrl = `https://www.linkedin.com/shareArticle?mini=true&url=${currentUrl}&title=${currentTitle}`;
              window.open(shareUrl, '_blank', 'width=600,height=400');
              break;
            case 'whatsapp':
              shareUrl = `https://api.whatsapp.com/send?text=${currentTitle} ${currentUrl}`;
              window.open(shareUrl, '_blank');
              break;
            case 'email':
              shareUrl = `mailto:?subject=${currentTitle}&body=Read this article: ${currentUrl}`;
              window.location.href = shareUrl;
              break;
            case 'copy':
              copyTextToClipboard(window.location.href, () => {
                const span = action.querySelector('span');
                if (span && !span.classList.contains('copy-feedback-active')) {
                  span.classList.add('copy-feedback-active');
                  
                  // Change text to "Copied" during the first transition (around 300ms)
                  setTimeout(() => {
                    span.textContent = 'Copied';
                  }, 300);

                  // Change text back to "Copy link" during the second transition (around 1700ms)
                  setTimeout(() => {
                    span.textContent = 'Copy link';
                  }, 1700);

                  // Clean up and close dropdown after animation ends (2000ms)
                  setTimeout(() => {
                    span.classList.remove('copy-feedback-active');
                    const container = action.closest('.share-menu-container');
                    if (container) {
                      container.querySelector('.share-dropdown').classList.remove('uni-social-share__show-dialog');
                      container.querySelector('.share-trigger-btn').classList.remove('active');
                    }
                  }, 2000);
                }
              });
              break;
          }
          
          // Close immediately for other platforms, but NOT copy platform
          if (platform !== 'copy') {
            shareContainers.forEach(container => {
              container.querySelector('.share-dropdown').classList.remove('uni-social-share__show-dialog');
              container.querySelector('.share-trigger-btn').classList.remove('active');
            });
          }
        });
      });

      const grid = document.getElementById('relatedGrid');
      const paginationEl = document.getElementById('relatedPagination');

      if (grid && paginationEl) {
        paginationEl.innerHTML = '';

        const prev = document.createElement('button');
        prev.className = 'rpg-btn rpg-arrow';
        prev.setAttribute('aria-label', 'Previous');
        prev.disabled = true; // Initially disabled since scroll is at 0
        prev.innerHTML = '<svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>';
        paginationEl.appendChild(prev);

        const next = document.createElement('button');
        next.className = 'rpg-btn rpg-arrow';
        next.setAttribute('aria-label', 'Next');
        next.innerHTML = '<svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>';
        paginationEl.appendChild(next);

        // Helper to get card width dynamically on click to avoid forced reflows during load/layout
        const getCardWidth = () => {
          const card = grid.querySelector('.related-card');
          return card ? card.offsetWidth + 20 : 0;
        };

        const updateButtons = () => {
          const scrollLeft = grid.scrollLeft;
          const maxScrollLeft = grid.scrollWidth - grid.clientWidth;
          prev.disabled = scrollLeft <= 5;
          next.disabled = scrollLeft >= maxScrollLeft - 5;
        };

        prev.addEventListener('click', () => {
          grid.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
        });

        next.addEventListener('click', () => {
          grid.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
        });

        let ticking = false;
        grid.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              updateButtons();
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // Defer initial button state check to window load event to ensure layout is completely stable and avoid forced reflows
        window.addEventListener('load', () => {
          setTimeout(() => {
            requestAnimationFrame(updateButtons);
          }, 300);
        });

        // Handle window resizing with debounce to avoid forced reflow
        let relatedResizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(relatedResizeTimer);
          relatedResizeTimer = setTimeout(() => {
            requestAnimationFrame(updateButtons);
          }, 150);
        });
      }

      // ── Shayari Card Actions (.csl) ──
      const cslElements = document.querySelectorAll('.csl');
      const articleEl = document.getElementById('articleContent');
      const cardPostId = articleEl ? articleEl.getAttribute('data-post-id') : 'default';

      cslElements.forEach((el, index) => {
        if (el.querySelector('.csl-actions')) return;

        const storageKey = `csl_liked_${cardPostId}_${index}`;
        const isLiked = localStorage.getItem(storageKey) === 'true';

        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'csl-actions';

        const likeBtn = document.createElement('button');
        likeBtn.className = `csl-btn csl-like-btn${isLiked ? ' liked' : ''}`;
        likeBtn.setAttribute('aria-label', 'Like Shayari');
        likeBtn.innerHTML = `
          <svg class="heart-outline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <svg class="heart-filled" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
          </svg>
          <span>${isLiked ? 'Liked' : 'Like'}</span>
        `;

        const copyBtn = document.createElement('button');
        copyBtn.className = 'csl-btn csl-copy-btn';
        copyBtn.setAttribute('aria-label', 'Copy Shayari');
        copyBtn.innerHTML = `
          <svg class="copy-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Copy</span>
        `;

        likeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const hasLiked = likeBtn.classList.contains('liked');
          if (hasLiked) {
            likeBtn.classList.remove('liked');
            likeBtn.querySelector('span').textContent = 'Like';
            localStorage.setItem(storageKey, 'false');
          } else {
            likeBtn.classList.add('liked');
            likeBtn.querySelector('span').textContent = 'Liked';
            localStorage.setItem(storageKey, 'true');
          }
        });

        copyBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          const clone = el.cloneNode(true);
          const actions = clone.querySelector('.csl-actions');
          if (actions) actions.remove();

          const textToCopy = clone.innerText.trim();

          copyTextToClipboard(textToCopy, () => {
            copyBtn.classList.add('copied');
            copyBtn.innerHTML = `
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Copied!</span>
            `;

            setTimeout(() => {
              copyBtn.classList.remove('copied');
              copyBtn.innerHTML = `
                <svg class="copy-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span>Copy</span>
              `;
            }, 2000);
          });
        });

        actionsDiv.appendChild(likeBtn);
        actionsDiv.appendChild(copyBtn);
        el.appendChild(actionsDiv);
      });

      // ── Image Optimization Layout & Animation (.imd) ──
      const imdImages = document.querySelectorAll('#articleContent img.imd');
      const observedTargets = Array.from(imdImages).map(img => {
        return img.closest('picture') || img;
      });

      const imdObserverOptions = {
        root: null,
        rootMargin: '0px 0px -40px 0px',
        threshold: 0.1
      };

      const imdObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      }, imdObserverOptions);

      // Batch all classList additions in a single rAF to avoid multiple style recalcs
      requestAnimationFrame(() => {
        observedTargets.forEach((target, index) => {
          target.classList.add('imd-container', index % 2 === 0 ? 'imd-float-left' : 'imd-float-right');
          imdObserver.observe(target);
        });
      });

      // ── Responsive Table Wrapper (Batched to eliminate forced reflow) ──
      requestAnimationFrame(() => {
        const tsaTables = document.querySelectorAll('#articleContent table');
        tsaTables.forEach(table => {
          if (!table.parentElement.classList.contains('qd-table-wrap')) {
            const wrapper = document.createElement('div');
            wrapper.className = 'qd-table-wrap';
            table.parentNode.insertBefore(wrapper, table);
            wrapper.appendChild(table);
          }
        });
      });

      // ── In-Article Native Ad Auto-Insertion (Multiple Slots for Long Posts) ──
      requestAnimationFrame(() => {
        const article = document.getElementById('articleContent');
        if (!article) return;
        const elements = article.querySelectorAll(':scope > p, :scope > h2, :scope > .qd-quiz-wrap');
        
        // Slot 1: Insert after 3rd paragraph/heading
        if (adsenseId && elements.length >= 3 && !article.querySelector('.ins-inarticle-ad-1')) {
          const target1 = elements[2];
          const adWrapper1 = document.createElement('div');
          adWrapper1.className = 'ins-inarticle-ad-1 my-8 text-center overflow-hidden';
          adWrapper1.innerHTML = `
            <ins class="adsbygoogle"
                 style="display:block; text-align:center;"
                 data-ad-layout="in-article"
                 data-ad-format="fluid"
                 data-ad-client="${adsenseId}"
                 data-ad-slot="7358005986"></ins>
          `;
          target1.parentNode.insertBefore(adWrapper1, target1.nextSibling);
          requestAnimationFrame(function() {
            try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
          });
        }

        // Slot 2: Insert after 8th paragraph/heading (for longer articles)
        if (adsenseId && elements.length >= 8 && !article.querySelector('.ins-inarticle-ad-2')) {
          const target2 = elements[7];
          const adWrapper2 = document.createElement('div');
          adWrapper2.className = 'ins-inarticle-ad-2 my-8 text-center overflow-hidden';
          adWrapper2.innerHTML = `
            <ins class="adsbygoogle"
                 style="display:block; text-align:center;"
                 data-ad-layout="in-article"
                 data-ad-format="fluid"
                 data-ad-client="${adsenseId}"
                 data-ad-slot="8678826515"></ins>
          `;
          target2.parentNode.insertBefore(adWrapper2, target2.nextSibling);
          requestAnimationFrame(function() {
            try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
          });
        }
      });

    });
  </script>

  {/* ═══ Conditional Component Injection (build-time detected) ═══ */}
  {hasMcqs && <McqStyles />}
  {hasFlashcards && <FlashcardStyles />}

  {/* ═══ Auto-generated Schema Markup ═══ */}
  {flashcardSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(flashcardSchema)} />
  )}
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

</BaseLayout>

<script define:vars={{ postId: post.id }}>
  // Non-blocking view tracker — fires after page is idle, doesn't affect LCP/FCP
  (function () {
    // Client-side rate-limiting: skip fetch if already viewed in last 24 hours
    const storageKey = 'viewed_post_' + postId;
    const lastViewed = localStorage.getItem(storageKey);
    const now = Date.now();
    if (lastViewed && (now - parseInt(lastViewed, 10)) < 24 * 60 * 60 * 1000) {
      return;
    }

    function trackView() {
      fetch('/api/track-view', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ postId }),
        keepalive: true, // Ensures request completes even if page navigates away
      })
      .then(res => {
        if (res.ok) {
          localStorage.setItem(storageKey, String(Date.now()));
        }
      })
      .catch(() => {}); // Silently ignore all errors
    }

    function scheduleTrack() {
      let tracked = false;
      const doTrack = () => {
        if (tracked) return;
        tracked = true;
        if ('requestIdleCallback' in window) {
          requestIdleCallback(trackView, { timeout: 3000 });
        } else {
          setTimeout(trackView, 500);
        }
      };

      // Delay execution to ensure it doesn't block LCP/FCP
      // Only track if the user interacts with the page or after 5 seconds
      const events = ['scroll', 'click', 'mousemove', 'keydown', 'touchstart'];
      const onInteract = () => {
        events.forEach(e => window.removeEventListener(e, onInteract));
        doTrack();
      };
      
      events.forEach(e => window.addEventListener(e, onInteract, { passive: true, once: true }));
      
      // Fallback if no interaction happens but page is kept open
      setTimeout(doTrack, 5000);
    }

    scheduleTrack();
  })();
</script>
