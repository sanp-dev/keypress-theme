---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import MoreNews from "../components/MoreNews.astro";
import PerspectiveHighlight from "../components/PerspectiveHighlight.astro";
import PostCard from "../components/PostCard.astro";
import Newsletter from "../components/Newsletter.astro";
import Currentaffairs from "../components/Currentaffairs.astro";
import PopularPosts from "../components/PopularPosts.astro";
import Quizzes from "../components/Quizzes.astro";
import AdSense from "../components/AdSense.astro";

import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { cleanImageUrl } from "../utils/image";
import { SITE_CONFIG } from "../config/site";
import { POSTS_PER_PAGE } from "../utils/posts-api";

// ── Build-time: only process the data we actually render as HTML ─────────────
const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const initialPosts = sortedPosts.slice(0, POSTS_PER_PAGE);
const hasMorePages = sortedPosts.length > POSTS_PER_PAGE;

// Hero image preload — only the FIRST post image is processed at build time
const latestPost = sortedPosts[0];
let heroPreloadImage = undefined;
if (latestPost && latestPost.data.image) {
  try {
    const cleaned = cleanImageUrl(latestPost.data.image);
    const heroImageMeta = await getImage({
      src: cleaned,
      width: 1024,
      height: 576,
      widths: [480, 768, 1024, 1280],
      sizes: "(max-width: 1023px) 100vw, 750px",
      quality: 75,
    });
    heroPreloadImage = {
      src: heroImageMeta.src,
      srcSet: heroImageMeta.srcSet.attribute,
      sizes: "(max-width: 1023px) 100vw, 750px",
    };
  } catch (err) {
    console.error("Failed to generate preload metadata for hero image:", err);
  }
}
---

<BaseLayout
  isHomePage={true}
  title={SITE_CONFIG.title}
  description={SITE_CONFIG.description}
  preloadImage={heroPreloadImage}
>
  <Hero />
  <MoreNews />
  <!-- AdSense: Horizontal Ad above PerspectiveHighlight -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-[52px] pt-8">
    <AdSense slot="3323737681" format="auto" responsive="true" />
  </div>

  <PerspectiveHighlight />
  <Currentaffairs />
  <Newsletter />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-[52px] py-16">
    <h2
      class="text-[19px] font-[600] tracking-[1px] leading-[32px] mb-[24px] text-[#5f6368] font-['Google_Sans',Arial,sans-serif]"
    >
      ALL STORIES --
    </h2>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      id="postsContainer"
    >
      {
        initialPosts.map((post) => {
          const formattedDate = post.data.pubDate
            .toLocaleDateString("en-US", {
              month: "short",
              day: "2-digit",
            })
            .toUpperCase();

          return (
            <PostCard
              title={post.data.title}
              category={post.data.category}
              date={formattedDate}
              image={post.data.image}
              url={`/post/${post.id}/`}
              description={post.data.description}
            />
          );
        })
      }
    </div>

    {
      hasMorePages && (
        <div class="mt-16 flex justify-center">
          <button
            id="loadMoreBtn"
            class="px-8 py-3 border border-gray-300 rounded-full text-blue-600 font-medium hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            aria-label="Load more stories"
          >
            Load more stories
          </button>
        </div>
      )
    }
  </main>

  <!-- AdSense: Bottom Ad before Popular Posts -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-[52px] pb-8">
    <AdSense slot="2038576175" format="auto" responsive="true" />
  </div>

  <PopularPosts />
  <Quizzes />

  <script>
    // ── Home "Load More" — fetch-based static JSON approach ──────────────────
    // Pages 2, 3, … are pre-generated at build time as static JSON files at
    // /api/posts/home/{page}.json.  No inline data blob — zero memory overhead
    // at build time regardless of post count.

    (function () {
      const container = document.getElementById("postsContainer");
      const btn = document.getElementById("loadMoreBtn") as HTMLButtonElement | null;
      if (!btn || !container) return;

      let nextPage = 2;
      let loading = false;

      function renderPost(post: {
        id: string;
        title: string;
        description: string;
        category: string;
        pubDate: string;
        image1x: string;
        image2x: string;
      }): string {
        const dateObj = new Date(post.pubDate);
        const formattedDate = dateObj
          .toLocaleDateString("en-US", { month: "short", day: "2-digit" })
          .toUpperCase();

        const imageHtml = post.image1x
          ? `<div class="feed-image-wrap">
               <img
                 src="${post.image1x}"
                 srcset="${post.image1x} 1x, ${post.image2x} 2x"
                 alt="${post.title.replace(/"/g, "&quot;")}"
                 class="feed-image"
                 loading="lazy"
                 decoding="async"
               />
             </div>`
          : "";

        let descText = post.description || "";
        if (descText.length > 145) descText = descText.substring(0, 142) + "…";
        const descHtml = descText
          ? `<p class="feed-description">${descText}</p>`
          : "";

        return `<a href="/post/${post.id}/" class="feed-article group cursor-pointer text-inherit no-underline block">
          <div class="flex items-center">
            <span class="text-[#5f6368] text-[12px] font-medium tracking-[0.5px] uppercase">${formattedDate}</span>
            <span class="text-[#5f6368] mx-2 text-[16px] leading-none">·</span>
            <span class="text-[#1a73e8] text-[12px] font-medium tracking-[0.5px] uppercase">${post.category}</span>
          </div>
          <div class="feed-content">
            ${imageHtml}
            <h2 class="feed-title font-normal font-['Google_Sans',Arial,sans-serif] group-hover:underline decoration-[1.5px] underline-offset-[3px]">
              ${post.title}
            </h2>
            ${descHtml}
          </div>
        </a>`;
      }

      btn.addEventListener("click", async function () {
        if (loading) return;
        loading = true;
        btn.disabled = true;
        btn.textContent = "Loading…";

        try {
          const res = await fetch(`/api/posts/home/${nextPage}.json`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);

          const data = await res.json() as { posts: ReturnType<typeof Object>[], hasMore: boolean };
          const fragment = document.createDocumentFragment();

          for (const post of data.posts as Parameters<typeof renderPost>[0][]) {
            const div = document.createElement("div");
            div.innerHTML = renderPost(post).trim();
            const el = div.firstElementChild;
            if (el) fragment.appendChild(el);
          }

          container.appendChild(fragment);
          nextPage++;

          if (!data.hasMore) {
            btn.style.display = "none";
          } else {
            btn.textContent = "Load more stories";
          }
        } catch (err) {
          console.error("[load-more] Failed to fetch posts:", err);
          btn.textContent = "Retry";
        } finally {
          loading = false;
          btn.disabled = false;
        }
      });
    })();
  </script>
</BaseLayout>
