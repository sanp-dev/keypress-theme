<!-- See More / Collapse Script -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    // ── 1. Page list & Category list collapse ──
    document
      .querySelectorAll<HTMLButtonElement>(".see-more-btn[data-target]")
      .forEach((btn) => {
        const targetId = btn.dataset.target!;
        const wrapper = document.getElementById(targetId);
        if (!wrapper) return;

        // Tags use a different system (data-tags-limit)
        if (btn.dataset.tagsLimit) return;

        const list = wrapper.querySelector<HTMLElement>("ul");
        if (!list) return;
        const items = list.querySelectorAll<HTMLElement>("[data-index]");
        const limit = parseInt(wrapper.dataset.limit ?? "4", 10);

        // Hide extra items initially
        items.forEach((item) => {
          const idx = parseInt(item.dataset.index ?? "0", 10);
          if (idx >= limit) item.style.display = "none";
        });

        let expanded = false;
        const labelMore = btn.dataset.labelMore ?? "See more";
        const labelLess = btn.dataset.labelLess ?? "Show less";

        btn.addEventListener("click", () => {
          expanded = !expanded;
          items.forEach((item) => {
            const idx = parseInt(item.dataset.index ?? "0", 10);
            if (idx >= limit) {
              item.style.display = expanded ? "" : "none";
            }
          });
          const chevron = btn.querySelector("svg");
          if (chevron)
            chevron.style.transform = expanded ? "rotate(180deg)" : "";
          btn.childNodes.forEach((node) => {
            if (node.nodeType === Node.TEXT_NODE) {
              node.textContent = " " + (expanded ? labelLess : labelMore);
            }
          });
        });
      });

    // ── 2. Tags cloud collapse ──
    document
      .querySelectorAll<HTMLButtonElement>(".see-more-btn[data-tags-limit]")
      .forEach((btn) => {
        const targetId = btn.dataset.target!;
        const wrapper = document.getElementById(targetId);
        if (!wrapper) return;
        const chips = wrapper.querySelectorAll<HTMLElement>(".tag-chip");
        const limit = parseInt(btn.dataset.tagsLimit ?? "12", 10);

        chips.forEach((chip) => {
          const idx = parseInt(chip.dataset.index ?? "0", 10);
          if (idx >= limit) chip.style.display = "none";
        });

        let expanded = false;
        const labelMore = btn.dataset.labelMore ?? "See more";
        const labelLess = btn.dataset.labelLess ?? "Show less";

        btn.addEventListener("click", () => {
          expanded = !expanded;
          chips.forEach((chip) => {
            const idx = parseInt(chip.dataset.index ?? "0", 10);
            if (idx >= limit) chip.style.display = expanded ? "" : "none";
          });
          const chevron = btn.querySelector("svg");
          if (chevron)
            chevron.style.transform = expanded ? "rotate(180deg)" : "";
          btn.childNodes.forEach((node) => {
            if (node.nodeType === Node.TEXT_NODE) {
              node.textContent = " " + (expanded ? labelLess : labelMore);
            }
          });
        });
      });
  });
</script>

