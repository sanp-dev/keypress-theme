---
// src/pages/sitemap.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { AUTHOR_REGISTRY, DEFAULT_AUTHOR } from "../config/authors";
import { Image } from "astro:assets";

import { SITE_CONFIG } from "../config/site";

const pageTitle = `Sitemap - ${SITE_CONFIG.name}`;
const pageDescription =
  `Browse the complete sitemap of ${SITE_CONFIG.name}. Find all pages, blog posts, categories, tags, and author profiles organized in a visual, easy-to-navigate structure.`;

// Fetch all blog posts
const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Extract unique categories
const categories = [...new Set(allPosts.map((p) => p.data.category))].sort();

// Extract unique primary tags
const allTags: string[] = [];
const seenTagSlugs = new Set<string>();
allPosts.forEach((post) => {
  const primaryTag = post.data.tags?.[0];
  if (primaryTag) {
    const slug = primaryTag.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)+/g, "");
    if (slug && !seenTagSlugs.has(slug)) {
      seenTagSlugs.add(slug);
      allTags.push(primaryTag);
    }
  }
});
allTags.sort();

// Look up table by slug
const profilesBySlug = Object.fromEntries(
  Object.values(AUTHOR_REGISTRY).map((p) => [p.slug, p]),
);

const slugifyAuthor = (author: string) =>
  author
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "");

// Extract unique authors with their profile info by resolving their slug
const authorMap = new Map<string, { displayName: string; postCount: number }>();
allPosts.forEach((post) => {
  const slug = post.data.authorSlug || slugifyAuthor(post.data.author);
  const existing = authorMap.get(slug);
  if (existing) {
    existing.postCount += 1;
  } else {
    authorMap.set(slug, { displayName: post.data.author, postCount: 1 });
  }
});

const authorProfiles = Array.from(authorMap.entries())
  .map(([slug, { displayName, postCount }]) => {
    const registryProfile = profilesBySlug[slug];
    const profile = registryProfile ?? {
      ...DEFAULT_AUTHOR,
      name: displayName,
      slug: slug,
    };
    return {
      name: profile.name,
      profile,
      postCount,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

// Static pages
const staticPages = [
  { title: "Home", href: "/", icon: "home" },
  { title: "About Us", href: "/about/", icon: "info" },
  { title: "Contact Us", href: "/contact/", icon: "mail" },
  { title: "Search", href: "/search/", icon: "search" },
  { title: "Privacy Policy", href: "/privacy-policy/", icon: "shield" },
  { title: "Terms & Conditions", href: "/terms-and-conditions/", icon: "doc" },
  { title: "Disclaimer", href: "/disclaimer/", icon: "alert" },
];

// Helper: slugify
function slugify(str: string) {
  return str
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "");
}

function capitalize(str: string) {
  return str
    .split(' ')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// Collapse thresholds (items shown before "See More")
const PAGES_SHOW = 4;
const CAT_SHOW = 5;
const TAGS_SHOW = 12;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={[
    { name: "Home", url: Astro.url.origin + "/" },
    { name: "Sitemap", url: Astro.url.href },
  ]}
>
  <main class="sitemap-page">
    <!-- ── Header ── -->
    <header class="sitemap-header">
      <div class="sitemap-header-inner">
        <div class="sitemap-icon-badge">
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
          </svg>
        </div>
        <h1 class="sitemap-title">Sitemap</h1>
        <p class="sitemap-subtitle">
          Explore the complete structure of {SITE_CONFIG.name} — every page, post,
          category, and author in one place.
        </p>
        <div class="sitemap-stats">
          <span class="stat-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
              ></path></svg
            >
            {sortedPosts.length} Posts
          </span>
          <span class="stat-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
              ></path></svg
            >
            {categories.length} Categories
          </span>
          <span class="stat-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"
              ></path></svg
            >
            {allTags.length} Tags
          </span>
          <span class="stat-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
              ></path></svg
            >
            {authorProfiles.length} Authors
          </span>
        </div>
      </div>
    </header>

    <!-- ── Sitemap Grid (top 3 columns) ── -->
    <div class="sitemap-grid sitemap-grid--top">
      <!-- ═══ Section 1: Main Pages ═══ -->
      <section class="sitemap-section sitemap-section--pages">
        <div class="section-header">
          <div class="section-icon section-icon--blue">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          <h2 class="section-title">Main Pages</h2>
        </div>

        <!-- Collapsible wrapper -->
        <div class="collapsible-list" id="pages-list" data-limit={PAGES_SHOW}>
          <ul class="page-list">
            {
              staticPages.map((page, i) => (
                <li class="page-item" data-index={i}>
                  <a href={page.href} class="page-link">
                    <span class="page-link-icon">
                      {page.icon === "home" && (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
                        </svg>
                      )}
                      {page.icon === "info" && (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" />
                        </svg>
                      )}
                      {page.icon === "mail" && (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
                        </svg>
                      )}
                      {page.icon === "search" && (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                        </svg>
                      )}
                      {page.icon === "shield" && (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                        </svg>
                      )}
                      {page.icon === "doc" && (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zM13 9V3.5L18.5 9H13z" />
                        </svg>
                      )}
                      {page.icon === "alert" && (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
                        </svg>
                      )}
                    </span>
                    <span class="page-link-text">{page.title}</span>
                    <svg
                      class="page-link-arrow"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        {
          staticPages.length > PAGES_SHOW && (
            <button
              class="see-more-btn"
              data-target="pages-list"
              data-label-more={`+${staticPages.length - PAGES_SHOW} more pages`}
              data-label-less="Show less"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
              +{staticPages.length - PAGES_SHOW} more pages
            </button>
          )
        }
      </section>

      <!-- ═══ Section 2: Categories ═══ -->
      <section class="sitemap-section sitemap-section--categories">
        <div class="section-header">
          <div class="section-icon section-icon--green">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
              ></path>
            </svg>
          </div>
          <h2 class="section-title">Categories</h2>
        </div>

        <div class="collapsible-list" id="cat-list" data-limit={CAT_SHOW}>
          <ul class="category-list">
            {
              categories.map((cat, i) => {
                const count = allPosts.filter(
                  (p) => p.data.category === cat,
                ).length;
                return (
                  <li class="category-item" data-index={i}>
                    <a
                      href={`/category/${slugify(cat)}/`}
                      class="category-link"
                    >
                      <span class="category-name">{cat}</span>
                      <span class="category-count">{count}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
        {
          categories.length > CAT_SHOW && (
            <button
              class="see-more-btn see-more-btn--green"
              data-target="cat-list"
              data-label-more={`+${categories.length - CAT_SHOW} more`}
              data-label-less="Show less"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
              +{categories.length - CAT_SHOW} more
            </button>
          )
        }
      </section>

      <!-- ═══ Section 3: Tags ═══ -->
      <section class="sitemap-section sitemap-section--tags">
        <div class="section-header">
          <div class="section-icon section-icon--amber">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"
              ></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
          </div>
          <h2 class="section-title">Tags</h2>
        </div>

        <div class="tags-cloud-wrapper" id="tags-cloud-wrapper">
          <div class="tags-cloud" id="tags-cloud">
            {
              allTags.map((tag, i) => (
                <a
                  href={`/label/${slugify(tag)}/`}
                  class="tag-chip"
                  data-index={i}
                >
                  <svg
                    width="11"
                    height="11"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z" />
                  </svg>
                  {capitalize(tag)}
                </a>
              ))
            }
            {
              allTags.length === 0 && (
                <p class="empty-note">No tags found yet.</p>
              )
            }
          </div>
        </div>
        {
          allTags.length > TAGS_SHOW && (
            <button
              class="see-more-btn see-more-btn--amber"
              data-target="tags-cloud-wrapper"
              data-tags-limit={TAGS_SHOW}
              data-label-more={`+${allTags.length - TAGS_SHOW} more tags`}
              data-label-less="Show less tags"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
              +{allTags.length - TAGS_SHOW} more tags
            </button>
          )
        }
      </section>
    </div>

    <!-- ── Section 6: All Blog Posts (narrowed on desktop) ── -->
    <div class="sitemap-posts-wrap">
      <section class="sitemap-section sitemap-section--posts">
        <div class="section-header">
          <div class="section-icon section-icon--purple">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h2 class="section-title">All Blog Posts</h2>
          <span class="section-count">{sortedPosts.length}</span>
        </div>
        <div class="posts-list">
          {
            sortedPosts.map((post, index) => {
              const date = post.data.pubDate.toLocaleDateString("en-US", {
                month: "short",
                day: "2-digit",
                year: "numeric",
              });
              return (
                <a
                  href={`/post/${post.id}/`}
                  class="post-row"
                  style={`--delay: ${Math.min(index * 25, 500)}ms`}
                >
                  <span class="post-index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div class="post-info">
                    <span class="post-title-text">{post.data.title}</span>
                    <div class="post-meta">
                      <span class="post-category-badge">
                        {post.data.category}
                      </span>
                      <span class="post-date">{date}</span>
                    </div>
                  </div>
                  <svg
                    class="post-arrow"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </a>
              );
            })
          }
        </div>
      </section>
    </div>

    <!-- ── Authors + Feeds row (side by side on desktop) ── -->
    <div class="sitemap-grid sitemap-grid--bottom">
      <!-- ═══ Section 4: Authors ═══ -->
      <section class="sitemap-section sitemap-section--authors">
        <div class="section-header">
          <div class="section-icon section-icon--red">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h2 class="section-title">Authors</h2>
        </div>
        <ul class="author-list">
          {
            authorProfiles.map(({ name, profile, postCount }) => (
              <li class="author-item">
                <a href={`/author/${profile.slug}/`} class="author-link">
                  <div class="author-avatar">
                    {profile.avatarUrl ? (
                      <Image
                        src={profile.avatarUrl}
                        alt={name}
                        width={84}
                        height={84}
                        widths={[42, 84]}
                        sizes="42px"
                        class="author-avatar-img"
                        quality={75}
                      />
                    ) : null}
                    <span
                      class="author-avatar-fallback"
                      style={profile.avatarUrl ? "display:none" : ""}
                    >
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                      </svg>
                    </span>
                  </div>
                  <div class="author-info">
                    <span class="author-name">{name}</span>
                    <span class="author-role">{profile.role}</span>
                    <span class="author-posts">
                      {postCount} {postCount === 1 ? "post" : "posts"}
                    </span>
                  </div>
                  <svg
                    class="page-link-arrow"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ═══ Section 5: Feeds & Resources ═══ -->
      <section class="sitemap-section sitemap-section--feeds">
        <div class="section-header">
          <div class="section-icon section-icon--teal">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
          </div>
          <h2 class="section-title">Feeds & Resources</h2>
        </div>
        <ul class="page-list">
          <li class="page-item">
            <a href="/rss.xml" class="page-link" target="_blank" rel="noopener">
              <span class="page-link-icon">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M6.18 15.64a2.18 2.18 0 1 0 2.18 2.18 2.18 2.18 0 0 0-2.18-2.18zM4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"
                  ></path></svg
                >
              </span>
              <span class="page-link-text">RSS Feed</span>
              <svg
                class="page-link-arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><polyline points="9 18 15 12 9 6"></polyline></svg
              >
            </a>
          </li>
          <li class="page-item">
            <a
              href="/sitemap-posts.xml"
              class="page-link"
              target="_blank"
              rel="noopener"
            >
              <span class="page-link-icon">
