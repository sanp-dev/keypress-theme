---
import { SITE_CONFIG } from "../config/site";

// All icons are monochrome currentColor - color is controlled via CSS
const socialLinks = [
  {
    name: "Instagram",
    url: SITE_CONFIG.socials.instagram || "",
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="2" width="20" height="20" rx="5.5"/>
      <circle cx="12" cy="12" r="4.3"/>
      <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  {
    name: "X (Twitter)",
    url: SITE_CONFIG.socials.twitter || "",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M13.16 10.77L18.24 5h-1.21l-4.42 5.01L8.77 5H5l5.35 7.55L5 19h1.21l4.68-5.3 3.74 5.3H18.8l-5.64-8.23zm-1.66 1.88-.54-.76-4.3-6.03H8.5l3.47 4.87.54.76 4.52 6.34h-1.84l-3.7-5.18z"/>
    </svg>`,
  },
  {
    name: "YouTube",
    url: SITE_CONFIG.socials.youtube || "",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="5" width="20" height="14" rx="4"/>
      <polygon points="10,9 16,12 10,15" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  {
    name: "Facebook",
    url: SITE_CONFIG.socials.facebook || "",
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3V2z"/>
    </svg>`,
  },
  {
    name: "LinkedIn",
    url: SITE_CONFIG.socials.linkedin || "",
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/>
      <rect x="2" y="9" width="4" height="12" rx="0.5"/>
      <circle cx="4" cy="4" r="2"/>
    </svg>`,
  },
  {
    name: "Telegram",
    url: SITE_CONFIG.socials.telegram || "",
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M20.665 3.717l-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l.002.001-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434z"/>
    </svg>`,
  },
  {
    name: "GitHub",
    url: SITE_CONFIG.socials.github || "",
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.867 8.167 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.53 1.03 1.53 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
    </svg>`,
  },
].filter(link => link.url && link.url !== "#" && link.url !== "");

const globalLinks = [
  { label: "About Us", href: "/about/" },
  { label: "Contact Us", href: "/contact/" },
  { label: "Privacy Policy", href: "/privacy-policy/" },
  { label: "Terms & Conditions", href: "/terms-and-conditions/" },
  { label: "Disclaimer", href: "/disclaimer/" },
  { label: "Sitemap", href: "/sitemap/" },
];
---

<footer class="bg-[#f8f9fa] border-t border-gray-200 mt-16">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-8 py-8">
    <!-- ── Upper: Follow Us + Social Icons ── -->
    <div
      class="flex flex-col md:flex-row items-start md:items-center border-b border-gray-200 pb-7 mb-7 gap-4"
    >
      <span class="ft-follow-label">Follow Us</span>

      <ul class="flex flex-wrap gap-6 mt-1 md:mt-0 items-center">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.url}
                aria-label={link.name}
                title={link.name}
                class="social-icon-btn"
              >
                <Fragment set:html={link.svg} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ── Lower: Logo + Links + Copyright ── -->
    <div class="flex flex-col md:flex-row md:items-center gap-5">
      <!-- Logo & Mobile Subscribe Button Container -->
      <div class="flex items-center justify-between w-full md:w-auto">
        <!-- Dynamic logo wordmark -->
        <a
          href="/"
          translate="no"
          class="notranslate footer-logo shrink-0 flex items-center text-[17px] sm:text-[22px] font-medium text-[#5f6368] tracking-[0.5px] whitespace-nowrap"
          aria-label={SITE_CONFIG.name}
          style="font-family:'Google Sans',Arial,sans-serif;"
        >
          {SITE_CONFIG.logoLetters && SITE_CONFIG.logoLetters.length > 0 ? (
            <span class="font-bold mr-1.5 text-[19px] sm:text-[24px]">
              {SITE_CONFIG.logoLetters.map((letter) => (
                <span class={letter.color}>{letter.char}</span>
              ))}
            </span>
          ) : null}
          {SITE_CONFIG.logoTextSuffix}
        </a>

        <!-- Mobile Subscribe + Get Theme Buttons -->
        <div class="flex md:hidden flex-col items-end shrink-0 gap-[5px]">
          <button
            id="nt-link-mobile"
            class="w-[125px] h-[34px] bg-[#1a73e8] hover:bg-[#174ea6] text-white text-[12px] font-medium rounded-lg transition-colors cursor-pointer outline-none shadow-sm flex items-center justify-center gap-1.5 font-['Google_Sans',Arial,sans-serif]"
          >
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"></path>
            </svg>
            <span>Subscribe</span>
          </button>
        </div>
      </div>

      <!-- Global links -->
      <ul
        class="grid grid-cols-2 md:flex md:flex-row md:items-center gap-x-4 gap-y-3 md:gap-x-5 md:gap-y-0 mt-2 md:mt-0"
      >
        {
          globalLinks.map((link) => (
            <li>
              <a href={link.href} class="ft-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Mobile Cookie Settings Trigger (Only visible on mobile, between links and copyright, on the left) -->
      {SITE_CONFIG.showCookieConsent && (
        <div class="flex md:hidden mt-4 w-full justify-start pl-1">
          <button
            id="footer-cookie-trigger"
            class="flex items-center gap-2 text-[14px] text-[#5f6368] hover:text-[#0b57d0] cursor-pointer outline-none select-none transition-colors"
            style="font-family:'Google Sans',sans-serif;"
          >
            <!-- Mini Cookie Icon -->
            <svg class="w-5 h-5 text-[#80868b] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c.81 0 1.58-.1 2.33-.28C14.11 20.89 14 19.97 14 19c0-3.87 3.13-7 7-7 .97 0 1.89.11 2.72.33C23.9 13.58 24 12.81 24 12c0-5.52-4.48-10-10-10zm-3 7.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm6 4c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm-5 4c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm-2-4c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm7-4c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
            </svg>
            <span>Cookie Settings</span>
          </button>
        </div>
      )}

      <!-- Copyright -->
      <div
        class="md:ml-auto flex items-center justify-center md:justify-end w-full md:w-auto mt-4 md:mt-0"
      >
        <span class="text-[13px] sm:text-[15px] text-[#5f6368] flex items-center gap-1.5 flex-wrap justify-center md:justify-end">
          <span class="flex items-center gap-1">
            <span style="font-size: 1.2em; vertical-align: text-top;">©</span>
            <span>{new Date().getFullYear()} {SITE_CONFIG.name}. All rights reserved.</span>
          </span>
          <span class="inline-flex items-center justify-center shrink-0" title="Verified Theme">
            <svg class="w-[18px] h-[18px] text-[#80868b] fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" />
              <path d="m9 12 2 2 4-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </span>
      </div>

    </div>
  </div>
</footer>

<style>
  /* ── "Follow Us" label ── */
  .ft-follow-label {
    font-size: 13px;
    font-weight: bold;
    color: #50585e;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── Social icon button ── */
  .social-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5f6368; /* default: medium grey (passes contrast check) */
    transition:
      color 0.2s ease,
      transform 0.18s ease;
    line-height: 0;
  }

  .social-icon-btn:hover {
    color: #3c4043; /* hover: darker grey */
    transform: translateY(-2px);
  }

  .social-icon-btn:active {
    transform: translateY(0);
    color: #202124;
  }

  /* ── Footer logo ── */
  .footer-logo {
    line-height: 1;
    text-decoration: none;
    opacity: 1; /* default: full opacity to ensure accessible contrast */
    transition: opacity 0.2s;
  }
  .footer-logo:hover {
    opacity: 0.85;
  }

  /* ── Footer nav links ── */
  .ft-link {
    font-size: 15px;
    font-weight: 500;
    color: #5f6368; /* default: medium grey (passes contrast check) */
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .ft-link:hover {
    color: #202124;
  }
  .ft-link-gradient {
    background: linear-gradient(135deg, #1a73e8, #8b5cf6);
    color: white !important;
    padding: 6px 16px;
    border-radius: 9999px;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(26, 115, 232, 0.25);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }
  .ft-link-gradient:hover {
    transform: translateY(-1.5px);
    box-shadow: 0 4px 12px rgba(26, 115, 232, 0.4);
    background: linear-gradient(135deg, #155fa0, #7c3aed);
  }
</style>
