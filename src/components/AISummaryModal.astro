---
// src/components/AISummaryModal.astro
export interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<!-- AI Summary Dialog -->
<dialog id="ai-summary-modal" aria-modal="true" aria-label="AI-generated Summary">
  
  <div class="modal-card">
    
    <!-- Animated gradient orbs (decorative, aria-hidden) -->
    <div class="orb orb-1" aria-hidden="true"></div>
    <div class="orb orb-2" aria-hidden="true"></div>

    <!-- Header -->
    <div class="modal-header">
      <div class="modal-title-group">
        <div class="modal-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <use href="#ai-generate-summary"></use>
          </svg>
        </div>
        <div>
          <h3 class="modal-title">AI-generated Summary</h3>
          <p class="modal-subtitle">Powered by Gemini AI</p>
        </div>
      </div>

      <!-- Close Button -->
      <button id="close-ai-modal" class="modal-close-btn" aria-label="Close summary">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Divider -->
    <div class="modal-divider" aria-hidden="true"></div>

    <!-- Content Area -->
    <div class="modal-body custom-scrollbar">
      <div id="ai-summary-content" class="modal-content-text">
        {summary.split('\n').filter(p => p.trim() !== '').map(paragraph => (
          <p class="summary-para">{paragraph}</p>
        ))}
      </div>
    </div>
    
    <!-- Footer Disclaimer -->
    <div class="modal-footer">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" style="flex-shrink:0;opacity:0.6">
        <circle cx="12" cy="12" r="10" stroke-width="2"/>
        <path d="M12 8v4M12 16h.01" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span>AI summary may contain inaccuracies. Read the full article for complete context.</span>
    </div>

  </div>
</dialog>

<style>
  /* ─── CSS Custom Properties ─────────────────────────────── */
  :root {
    --modal-radius: 20px;
    --modal-spring: cubic-bezier(0.22, 1, 0.36, 1);
    --modal-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --modal-ease-in: cubic-bezier(0.55, 0, 1, 0.45);
    --modal-open-dur: 0.42s;
    --modal-close-dur: 0.26s;
  }

  /* ─── Dialog Base ─────────────────────────────────────── */
  dialog {
    all: unset; /* reset UA stylesheet */
    display: none; /* hidden by default — crucial after all:unset */
    position: fixed;
    inset: 0;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    overflow: hidden;
    padding: 16px;
    box-sizing: border-box;
    pointer-events: none;
    z-index: 9999;
    /* GPU layer */
    will-change: opacity;
    transform: translateZ(0);
  }

  dialog[open] {
    display: flex;
    pointer-events: auto;
    animation: dialogFadeIn var(--modal-open-dur) var(--modal-ease-out) forwards;
  }

  dialog.modal-closing {
    animation: dialogFadeOut var(--modal-close-dur) var(--modal-ease-in) forwards;
    pointer-events: none;
  }

  /* ─── Backdrop ───────────────────────────────────────── */
  dialog::backdrop {
    background: transparent;
  }

  /* We handle backdrop ourselves with a pseudo on dialog */
  dialog::before {
    content: '';
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 20, 0);
    backdrop-filter: blur(0px) saturate(1);
    -webkit-backdrop-filter: blur(0px) saturate(1);
    z-index: -1;
    transition: none;
    will-change: backdrop-filter, background;
  }

  dialog[open]::before {
    animation: backdropIn var(--modal-open-dur) var(--modal-ease-out) forwards;
  }

  dialog.modal-closing::before {
    animation: backdropOut var(--modal-close-dur) var(--modal-ease-in) forwards;
  }

  /* ─── Modal Card ─────────────────────────────────────── */
  .modal-card {
    position: relative;
    background: #fff;
    border-radius: var(--modal-radius);
    box-shadow:
      0 2px 6px rgba(0,0,0,0.04),
      0 8px 24px rgba(0,0,0,0.08),
      0 24px 64px rgba(0,0,0,0.12),
      0 0 0 1px rgba(255,255,255,0.6) inset;
    width: 100%;
    max-width: 620px;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* GPU compositing */
    will-change: transform, opacity;
    transform: translateZ(0);
    /* Card entrance is driven by its own animation */
    animation: cardIn var(--modal-open-dur) var(--modal-spring) forwards;
  }

  dialog.modal-closing .modal-card {
    animation: cardOut var(--modal-close-dur) var(--modal-ease-in) forwards;
  }

  /* ─── Decorative Orbs ────────────────────────────────── */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
  }

  .orb-1 {
    width: 220px;
    height: 220px;
    top: -80px;
    right: -60px;
    background: radial-gradient(circle, rgba(66,133,244,0.18) 0%, transparent 70%);
    animation: orbFloat1 8s ease-in-out infinite;
  }

  .orb-2 {
    width: 160px;
    height: 160px;
    bottom: -40px;
    left: -30px;
    background: radial-gradient(circle, rgba(234,67,53,0.12) 0%, transparent 70%);
    animation: orbFloat2 10s ease-in-out infinite;
  }

  /* ─── Header ─────────────────────────────────────────── */
  .modal-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 16px 20px;
    background: linear-gradient(135deg, #f0f4ff 0%, #fff5f5 50%, #f0fff4 100%);
    flex-shrink: 0;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .modal-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    flex-shrink: 0;
  }

  .modal-icon svg {
    color: #5f6368;
  }

  .modal-title {
    font-size: 17px;
    font-weight: 700;
    color: #1a1a2e;
    font-family: 'Google Sans', Arial, sans-serif;
    margin: 0;
    letter-spacing: -0.2px;
  }

  .modal-subtitle {
    font-size: 12px;
    color: #5f6368;
    font-family: 'Google Sans', Arial, sans-serif;
    margin: 2px 0 0 0;
    letter-spacing: 0.1px;
  }

  .modal-close-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: none;
    background: rgba(0,0,0,0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5f6368;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
    outline: none;
  }

  .modal-close-btn:hover {
    background: rgba(234,67,53,0.1);
    color: #ea4335;
    transform: scale(1.08);
  }

  .modal-close-btn:active {
    transform: scale(0.94);
  }

  /* ─── Divider ─────────────────────────────────────────── */
  .modal-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, #dadce0 20%, #dadce0 80%, transparent);
    flex-shrink: 0;
  }

  /* ─── Body / Content ─────────────────────────────────── */
  .modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px 26px;
    background: #fff;
    overscroll-behavior: contain;
  }

  .modal-content-text {
    font-family: 'Google Sans', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.85;
    color: #3c4043;
  }

  .summary-para {
    margin: 0 0 16px 0;
    opacity: 0;
    transform: translateY(6px);
    animation: paraFadeIn 0.4s var(--modal-ease-out) forwards;
  }

  .summary-para:last-child {
    margin-bottom: 0;
  }

  /* Stagger each paragraph */
  .summary-para:nth-child(1)  { animation-delay: 0.28s; }
  .summary-para:nth-child(2)  { animation-delay: 0.36s; }
  .summary-para:nth-child(3)  { animation-delay: 0.44s; }
  .summary-para:nth-child(4)  { animation-delay: 0.52s; }
  .summary-para:nth-child(5)  { animation-delay: 0.60s; }
  .summary-para:nth-child(6)  { animation-delay: 0.68s; }
  .summary-para:nth-child(7)  { animation-delay: 0.76s; }
  .summary-para:nth-child(8)  { animation-delay: 0.84s; }
  .summary-para:nth-child(9)  { animation-delay: 0.92s; }
  .summary-para:nth-child(10) { animation-delay: 1.00s; }

  /* ─── Footer ─────────────────────────────────────────── */
  .modal-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 20px;
    background: #f8f9fa;
    border-top: 1px solid #e8eaed;
    font-size: 12px;
    color: #80868b;
    font-family: 'Google Sans', Arial, sans-serif;
    flex-shrink: 0;
    line-height: 1.5;
  }

  /* ─── Custom Scrollbar ───────────────────────────────── */
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #dadce0 transparent;
  }
  .custom-scrollbar::-webkit-scrollbar { width: 5px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #dadce0;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #bdc1c6;
  }

  /* ─── Keyframes ──────────────────────────────────────── */
  @keyframes dialogFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes dialogFadeOut {
    from { opacity: 1; }
    to   { opacity: 0; }
  }

  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @keyframes cardOut {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }

  @keyframes backdropIn {
    from {
      background: rgba(10, 10, 20, 0);
      backdrop-filter: blur(0px) saturate(1);
      -webkit-backdrop-filter: blur(0px) saturate(1);
    }
    to {
      background: rgba(10, 10, 20, 0.45);
      backdrop-filter: blur(6px) saturate(1.4);
      -webkit-backdrop-filter: blur(6px) saturate(1.4);
    }
  }
  @keyframes backdropOut {
    from {
      background: rgba(10, 10, 20, 0.45);
      backdrop-filter: blur(6px) saturate(1.4);
      -webkit-backdrop-filter: blur(6px) saturate(1.4);
    }
    to {
      background: rgba(10, 10, 20, 0);
      backdrop-filter: blur(0px) saturate(1);
      -webkit-backdrop-filter: blur(0px) saturate(1);
    }
  }

  @keyframes paraFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes iconPulse {
    0%, 100% { box-shadow: 0 4px 12px rgba(66,133,244,0.3); }
    50%       { box-shadow: 0 4px 20px rgba(66,133,244,0.5); }
  }

  @keyframes orbFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%       { transform: translate(-12px, 14px) scale(1.06); }
  }
  @keyframes orbFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%       { transform: translate(10px, -12px) scale(1.04); }
  }

  /* ─── Reduced Motion ─────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    dialog[open],
    dialog.modal-closing,
    .modal-card,
    dialog.modal-closing .modal-card,
    dialog[open]::before,
    dialog.modal-closing::before {
      animation-duration: 0.01ms !important;
    }
    .orb-1, .orb-2, .modal-icon {
      animation: none;
    }
    .summary-para {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script is:inline>
(function () {

  document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('ai-summary-modal');
    const openBtn = document.getElementById('open-ai-summary-btn');
    const closeBtn = document.getElementById('close-ai-modal');
    const contentEl = document.getElementById('ai-summary-content');
    if (!modal || !openBtn || !closeBtn || !contentEl) return;

    // Store original paragraphs for restore
    const originalParas = Array.from(contentEl.querySelectorAll('p')).map(p => p.textContent);

    // Restore full content instantly
    function restoreFullContent() {
      contentEl.innerHTML = originalParas.map(p => `<p class="summary-para" style="opacity:1;transform:none;animation:none;margin:0 0 16px 0;">${p}</p>`).join('');
    }

    // Focus trap (minimal – only close button)
    let previouslyFocused = null;
    function trapFocus(e) {
      if (e.key === 'Tab') {
        e.preventDefault();
        closeBtn.focus();
      }
    }

    // Open handler
    openBtn.addEventListener('click', () => {
      restoreFullContent();
      modal.showModal();
      document.body.style.overflow = 'hidden';
      previouslyFocused = document.activeElement;
      closeBtn.focus();
      modal.addEventListener('keydown', trapFocus);
    });

    // Close logic
    const CLOSE_DURATION = 280; // matches CSS close animation
    function closeModal() {
      modal.classList.add('modal-closing');
      setTimeout(() => {
        modal.close();
        modal.classList.remove('modal-closing');
        document.body.style.overflow = '';
        restoreFullContent();
        if (previouslyFocused) previouslyFocused.focus();
        modal.removeEventListener('keydown', trapFocus);
      }, CLOSE_DURATION);
    }
    closeBtn.addEventListener('click', closeModal);
    // Escape key
    modal.addEventListener('cancel', e => { e.preventDefault(); closeModal(); });
    // Backdrop click — dialog fills viewport, so clicking the dialog
    // itself (not a child like .modal-card) means clicking the backdrop.
    modal.addEventListener('click', e => {
      if (e.target === modal) {
        closeModal();
      }
    });
  });
})();
</script>