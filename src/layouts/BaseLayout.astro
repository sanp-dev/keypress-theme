---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Analytics from "../components/Analytics.astro";
import PushNotification from "../components/PushNotification.astro";
import ScrollButtons from "../components/ScrollButtons.astro";
import { SITE_CONFIG } from "../config/site";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: "website" | "article";
  author?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  category?: string;
  tags?: string[];
  noindex?: boolean;
  isHomePage?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  rssFeedUrl?: string;
  rssFeedTitle?: string;
  preloadImage?: {
    src: string;
    srcSet?: string;
    sizes?: string;
  };
}

const siteName = SITE_CONFIG.name;
const siteUrl = Astro.url.origin;
const logoUrl = `${siteUrl}/logo.png`;

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  image = `${Astro.url.origin}${SITE_CONFIG.defaultOgImage}`,
  url = Astro.url.href,
  type = "website",
  author = "",
  publishedTime = undefined,
  modifiedTime = undefined,
  category = "",
  tags = [],
  noindex = true,
  isHomePage = false,
  breadcrumbs = [],
  rssFeedUrl = "/rss.xml",
  rssFeedTitle = `${siteName} RSS`,
  preloadImage = undefined,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    <link rel="canonical" href={url} />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.src}
          imagesrcset={preloadImage.srcSet}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={rssFeedTitle}
      href={rssFeedUrl}
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content={SITE_CONFIG.themeColor} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {
      type === "article" && publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      type === "article" && modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    {
      type === "article" && author && (
        <meta property="article:author" content={author} />
      )
    }
    {
      type === "article" && category && (
        <meta property="article:section" content={category} />
      )
    }
    {
      type === "article" &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Preconnect to site domain -->
    <link rel="preconnect" href={SITE_CONFIG.domain} crossorigin />
    <link rel="dns-prefetch" href={SITE_CONFIG.domain} />

    <!-- Preconnect to image CDN domain -->
    {SITE_CONFIG.cdnDomain && (
      <>
        <link rel="preconnect" href={SITE_CONFIG.cdnDomain} crossorigin />
        <link rel="dns-prefetch" href={SITE_CONFIG.cdnDomain} />
      </>
    )}



    <!-- Preload critical local fonts to break the critical request chain -->
    <link
      rel="preload"
      href="/fonts/google-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/google-sans-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/google-sans-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />


    {
      isHomePage && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
              {
                "@type": "Organization",
                "@id": `${siteUrl}/#organization`,
                name: siteName,
                url: siteUrl,
                logo: logoUrl,
              },
              {
                "@type": "WebSite",
                "@id": `${siteUrl}/#website`,
                url: siteUrl,
                name: siteName,
                alternateName: [siteName.replace(/\s+/g, ''), new URL(siteUrl).hostname],
                publisher: { "@id": `${siteUrl}/#organization` },
                potentialAction: {
                  "@type": "SearchAction",
                  target: `${siteUrl}/search?q={search_term_string}`,
                  "query-input": "required name=search_term_string",
                },
              },
            ],
          })}
        />
      )
    }

    {
      breadcrumbs.length > 0 && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: breadcrumbs.map((item, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: item.name,
              item: item.url,
            })),
          })}
        />
      )
    }

    {
      type === "article" && publishedTime && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Article",
            headline: title,
            description: description,
            image: image,
            author: author ? { 
              "@type": "Person", 
              name: author,
              url: `${siteUrl}/author/${author.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '')}/`
            } : undefined,
            publisher: {
              "@type": "Organization",
              name: siteName,
              logo: { "@type": "ImageObject", url: logoUrl },
            },
            datePublished: publishedTime.toISOString(),
            dateModified: modifiedTime
              ? modifiedTime.toISOString()
              : publishedTime.toISOString(),
            mainEntityOfPage: { "@type": "WebPage", "@id": url },
            articleSection: category,
            keywords: tags.join(", "),
          })}
        />
      )
    }
    <!-- Smart image error fallback detector -->
    <script is:inline>
      window.addEventListener(
        "error",
        function (event) {
          var target = event.target;
          if (target && target.tagName === "IMG") {
            if (target.dataset.fallbackApplied) return;
            target.dataset.fallbackApplied = "true";

            target.removeAttribute("srcset");
            var picture = target.closest("picture");
            if (picture) {
              var sources = picture.querySelectorAll("source");
              sources.forEach(function (src) {
                src.remove();
              });
            }

            var svg =
              '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">' +
              '<defs>' +
              '<linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">' +
              '<stop offset="0%" stop-color="#f8faff"/>' +
              '<stop offset="50%" stop-color="#e8f0fe"/>' +
              '<stop offset="100%" stop-color="#d2e3fc"/>' +
              '</linearGradient>' +
              '<pattern id="dotGrid" x="0" y="0" width="30" height="30" patternUnits="userSpaceOnUse">' +
              '<circle cx="15" cy="15" r="1.5" fill="#1a73e8" opacity="0.15"/>' +
              '</pattern>' +
              '</defs>' +
              '<rect width="100%" height="100%" fill="url(#bgGrad)"/>' +
              '<rect width="100%" height="100%" fill="url(#dotGrid)"/>' +
              '<path d="M-100,225 L900,225" stroke="#1a73e8" stroke-width="1" stroke-dasharray="10 15" opacity="0.1"/>' +
              '<circle cx="400" cy="225" r="160" stroke="#1a73e8" stroke-width="2" fill="none" opacity="0.05"/>' +
              '<circle cx="400" cy="225" r="220" stroke="#1a73e8" stroke-width="1" stroke-dasharray="5 5" fill="none" opacity="0.03"/>' +
              '<g transform="translate(400, 170)">' +
              '<circle cx="0" cy="0" r="45" fill="#e8f0fe" opacity="0.6" />' +
              '<circle cx="0" cy="0" r="45" stroke="#8ab4f8" stroke-width="1.5" stroke-dasharray="4 4" fill="none" opacity="0.8" />' +
              '<rect x="-18" y="-24" width="36" height="48" rx="4" fill="#ffffff" stroke="#1a73e8" stroke-width="2" transform="rotate(-6)" />' +
              '<line x1="-10" y1="-14" x2="10" y2="-14" stroke="#d2e3fc" stroke-width="2" stroke-linecap="round" transform="rotate(-6)" />' +
              '<line x1="-10" y1="-6" x2="6" y2="-6" stroke="#d2e3fc" stroke-width="2" stroke-linecap="round" transform="rotate(-6)" />' +
              '<line x1="-10" y1="2" x2="2" y2="2" stroke="#d2e3fc" stroke-width="2" stroke-linecap="round" transform="rotate(-6)" />' +
              '<line x1="-10" y1="10" x2="-2" y2="10" stroke="#d2e3fc" stroke-width="2" stroke-linecap="round" transform="rotate(-6)" />' +
              '<path d="M0,-15 C0,-5 5,0 15,0 C5,0 0,5 0,15 C0,5 -5,0 -15,0 C-5,0 0,-5 0,-15 Z" fill="#eab308" transform="translate(22, -22) scale(0.7)" />' +
              '<path d="M-8,12 C-5,6 12,-15 25,-25 C23,-18 12,-2 2,6 C-3,10 -6,11 -8,12 Z" fill="#1a73e8" />' +
              '<path d="M-10,15 C-8,13 12,-15 25,-25" stroke="#174ea6" stroke-width="1.5" stroke-linecap="round" fill="none" />' +
              '</g>' +
              '<text x="50%" y="280" dominant-baseline="middle" text-anchor="middle" font-family="\'Google Sans\', Arial, sans-serif" font-size="24" font-weight="700" fill="#1a73e8" letter-spacing="4">DEMO BLOG</text>' +
              '<text x="50%" y="308" dominant-baseline="middle" text-anchor="middle" font-family="\'Google Sans\', Arial, sans-serif" font-size="12" font-weight="500" fill="#5f6368" letter-spacing="2" opacity="0.8">HEALTH and EDUCATION</text>' +
              '</svg>';


            target.src = "data:image/svg+xml;utf8," + encodeURIComponent(svg);
          }
        },
        true,
      );
    </script>
    {SITE_CONFIG.googleAdsenseId && (
      SITE_CONFIG.adsenseLazyLoad ? (
        <script is:inline define:vars={{ adsenseId: SITE_CONFIG.googleAdsenseId }}>
          (function() {
            var adsenseLoaded = false;
            function loadAdSense() {
              if (adsenseLoaded) return;
              adsenseLoaded = true;
              var script = document.createElement('script');
              script.async = true;
              script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adsenseId;
              script.crossOrigin = 'anonymous';
              document.head.appendChild(script);
            }
            var events = ['scroll', 'mousemove', 'mousedown', 'touchstart', 'keydown'];
            function triggerAndCleanup() {
              events.forEach(function(e) {
                window.removeEventListener(e, triggerAndCleanup);
              });
              loadAdSense();
            }
            events.forEach(function(e) {
              window.addEventListener(e, triggerAndCleanup, { passive: true, once: true });
            });
            // Safety fallback: 300ms if no interaction detected
            setTimeout(loadAdSense, 300);
          })();
        </script>
      ) : (
        <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE_CONFIG.googleAdsenseId}`} crossorigin="anonymous"></script>
      )
    )}
    <Analytics />
  </head>
  <body class="bg-white min-h-screen flex flex-col">
    <Header />

    <div class="flex-grow w-full">
      <slot />
    </div>

    <Footer />

    {SITE_CONFIG.showCookieConsent && <CookieConsent />}

    <PushNotification />

    <ScrollButtons />

    <!-- Lightweight Inline Prefetcher (Zero Network Requests, Deferred execution) -->
    <script is:inline>
      (function() {
        const prefetch = () => {
          // Skip if user has data saver or slow connection
          const conn = navigator.connection;
          if (conn && (conn.saveData || /2g/.test(conn.effectiveType))) return;

          const prefetched = new Set();
          const isLink = (el) => el && el.tagName === 'A' && el.href;

          const doPrefetch = (url) => {
            try {
              const u = new URL(url);
              // Only prefetch internal links that are not the current page and not already prefetched
              if (u.origin !== location.origin || prefetched.has(u.pathname) || u.pathname === location.pathname) return;
              prefetched.add(u.pathname);

              if (document.createElement('link').relList?.supports?.('prefetch')) {
                const link = document.createElement('link');
                link.rel = 'prefetch';
                link.href = url;
                document.head.appendChild(link);
              } else {
                fetch(url, { priority: 'low' }).catch(() => {});
              }
            } catch (e) {}
          };

          // Mouseover (hover) prefetch with slight delay to prevent prefetching on accidental hovers
          let hoverTimeout;
          document.addEventListener('mouseover', (e) => {
            const a = e.target.closest('a');
            if (isLink(a)) {
              if (hoverTimeout) clearTimeout(hoverTimeout);
              hoverTimeout = setTimeout(() => doPrefetch(a.href), 60);
            }
          }, { passive: true });

          // Touchstart (tap) prefetch for mobile devices
          document.addEventListener('touchstart', (e) => {
            const a = e.target.closest('a');
            if (isLink(a)) doPrefetch(a.href);
          }, { passive: true });
        };

        if ('requestIdleCallback' in window) {
          requestIdleCallback(prefetch);
        } else {
          setTimeout(prefetch, 1500);
        }
      })();
    </script>
  </body>
</html>
