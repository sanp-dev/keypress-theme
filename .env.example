# Keypress Theme - Environment Configuration Example
# Rename this file to `.env` when deploying locally or configuring environment variables.

# Analytics Configurations (Optional)
PUBLIC_GA_ID="G-0000000000"
PUBLIC_CLARITY_ID="0000000000"

# GA4 Data API credentials for Popular Posts feature (Optional)
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""

# Cloudflare R2 Bucket Credentials (Optional)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Firebase Push Notification & DB Credentials (Optional)
FIREBASE_SECRET=""
FIREBASE_URL=""
GEMINI_API_KEY=""
TURNSTILE_SECRET_KEY=""
