# Keypress Theme - Environment Configuration Example
# Copy this file to `.env` when deploying locally or configuring environment variables.
# Do NOT commit your actual `.env` file to Git!

# Analytics Configurations (Optional)
PUBLIC_GA_ID="G-0000000000"
PUBLIC_CLARITY_ID="0000000000"

# Google AdSense (Optional)
PUBLIC_GOOGLE_ADSENSE_ID=""

# Cloudflare Turnstile Captcha
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Contact Form Integration (Optional)
CONTACT_FORM_WEBHOOK_URL=""

# Custom User Agent for Internal/External Fetching (Optional)
CUSTOM_USER_AGENT=""

# GA4 Data API credentials for Popular Posts feature (Optional)
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""

# Cloudflare R2 Bucket Credentials (Optional)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Firebase Push Notification & DB Credentials (Optional)
FIREBASE_SECRET=""
FIREBASE_URL=""
GEMINI_API_KEY=""
